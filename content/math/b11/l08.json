x=\"200.1\" cy=\"53.2\" r=\"2.6\"/><text class=\"ft\" x=\"210\" y=\"44.7\" text-anchor=\"middle\" dominant-baseline=\"central\">B₁</text><circle class=\"fp\" cx=\"244\" cy=\"26\" r=\"2.6\"/><text class=\"ft\" x=\"254.3\" y=\"18.1\" text-anchor=\"middle\" dominant-baseline=\"central\">C₁</text><circle class=\"fp\" cx=\"69.9\" cy=\"26\" r=\"2.6\"/><text class=\"ft\" x=\"61.9\" y=\"15.8\" text-anchor=\"middle\" dominant-baseline=\"central\">D₁</text></svg></figure>"
