=\"56.6\" r=\"2.6\"/><text class=\"ft\" x=\"151.2\" y=\"44.6\" text-anchor=\"middle\" dominant-baseline=\"central\">L</text><circle class=\"fp\" cx=\"162.3\" cy=\"46.6\" r=\"2.6\"/><text class=\"ft\" x=\"170.1\" y=\"36.2\" text-anchor=\"middle\" dominant-baseline=\"central\">M</text><circle class=\"fp\" cx=\"123.9\" cy=\"46.6\" r=\"2.6\"/><text class=\"ft\" x=\"120.1\" y=\"34.2\" text-anchor=\"middle\" dominant-baseline=\"central\">N</text></svg></figure>"
