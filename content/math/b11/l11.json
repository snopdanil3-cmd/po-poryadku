.9\" text-anchor=\"middle\" dominant-baseline=\"central\">B₁</text><circle class=\"fp\" cx=\"244\" cy=\"26\" r=\"2.6\"/><text class=\"ft\" x=\"255.5\" y=\"19.9\" text-anchor=\"middle\" dominant-baseline=\"central\">C₁</text><circle class=\"fp\" cx=\"90.5\" cy=\"26\" r=\"2.6\"/><text class=\"ft\" x=\"82.6\" y=\"15.7\" text-anchor=\"middle\" dominant-baseline=\"central\">D₁</text><circle class=\"fp\" cx=\"135\" cy=\"84.3\" r=\"2.6\"/><text class=\"ft\" x=\"144.2\" y=\"75.1\" text-anchor=\"middle\" dominant-baseline=\"central\">O</text></svg></figure>"
  },
  {
   "q": "Радиус основания конуса равен $6$, высота равна $8$. а) Докажите, что центр вписанного в конус шара лежит на оси конуса. б) Найдите радиус вписанного шара.",
   "steps": [
    "а) Конус и вписанный шар симметричны относительно оси: любая плоскость, проходящая через ось, является плоскостью симметрии конуса, а шар вписанный в конус единственный. Центр шара принадлежит всем таким плоскостям, то есть оси.",
    "б) Осевое сечение равнобедренный треугольник со сторонами $10$, $10$, $12$, шар даёт вписанную окружность. $S=\\dfrac12\\cdot12\\cdot8=48$, $p=16$, $r=\\dfrac Sp=3$."
   ],
