 "hard": [
  {
   "id": "b05-l4-h1",
   "q": "Хорда $AB$ стягивает дугу $120^\\circ$ окружности радиуса $6$. Найдите $\\dfrac{AB}{\\sqrt3}$.",
   "a": 6,
   "hint": "Хорда $AB=2R\\sin\\dfrac\\alpha2$, где $\\alpha$ центральный угол. Здесь $\\sin60^\\circ=\\dfrac{\\sqrt3}2$.",
   "sol": [
    "Центральный угол равен $120^\\circ$, $AB=2R\\sin60^\\circ=2\\cdot6\\cdot\\dfrac{\\sqrt3}2=6\\sqrt3$.",
    "$\\dfrac{AB}{\\sqrt3}=6$."
   ],
   "fig": "<figure class=\"fig\"><svg viewBox=\"0 0 270 235\" width=\"270\" height=\"235\" role=\"img\" aria-label=\"Окружность радиуса 6, хорда AB стягивает дугу 120 градусов\"><circle class=\"fl\" cx=\"135\" cy=\"117.5\" r=\"91.5\"/><line class=\"fl\" x1=\"214.2\" y1=\"71.8\" x2=\"55.8\" y2=\"71.8\"/><line class=\"fl fd\" x1=\"135\" y1=\"117.5\" x2=\"214.2\" y2=\"71.8\"/><line class=\"fl fd\" x1=\"135\" y1=\"117.5\" x2=\"55.8\" y2=\"71.8\"/><path class=\"fa\" d=\"M148.9 109.5 A16 16 0 0 0 121.1 109.5\"/><text class=\"ft fn\" x=\"135\" y=\"89.5\" text-anchor=\"middle\" dominant-baseline=\"central\">120°</text><text class=\"ft fn\" x=\"180.6\" y=\"105\" text-anchor=\"middle\" dominant-baseline=\"central\">6</text><circle class=\"fp\" cx=\"135\" cy=\"117.5\" r=\"2.6\"/><text class=\"ft\" x=\"135\" y=\"131.5\" text-anchor=\"middle\" dominant-baseline=\"central\">O</text><circle class=\"fp\" cx=\"214.2\" cy=\"71.8\" r=\"2.6\"/><text class=\"ft\" x=\"227\" y=\"69.3\" text-anchor=\"middle\" dominant-baseline=\"central\">A</text><circle class=\"fp\" cx=\"55.8\" cy=\"71.8\" r=\"2.6\"/><text class=\"ft\" x=\"43\" y=\"69.3\" text-anchor=\"middle\" dominant-baseline=\"central\">B</text></svg></figure>"
  },
  {
   "id": "b05-l4-h2",
   "q": "Из точки $A$ к окружности радиуса $5$ проведены касательные $AB$ и $AC$, угол $BAC$ равен $60^\\circ$. Найдите расстояние от $A$ до центра окружности.",
   "a": 10,
   "hint": "$OA$ биссектриса угла $BAC$, поэтому $\\angle OAB=30^\\circ$. В прямоугольном треугольнике $OBA$ катет $OB$ лежит против угла $30^\\circ$.",
   "sol": [
    "$\\angle OAB=\\dfrac{60^\\circ}2=30^\\circ$ и $\\angle OBA=90^\\circ$.",
    "$OB=OA\\sin30^\\circ$, поэтому $OA=\\dfrac{5}{0{,}5}=10$."
   ],
   "fig": "<figure class=\"fig\"><svg viewBox=\"0 0 270 197.3\" width=\"270\" height=\"197.3\" role=\"img\" aria-label=\"Окружность радиуса 5, из точки A проведены две касательные под углом 60 градусов\"><circle class=\"fl\" cx=\"98.7\" cy=\"98.7\" r=\"72.7\"/><line class=\"fl\" x1=\"244\" y1=\"98.7\" x2=\"135\" y2=\"35.7\"/><line class=\"fl\" x1=\"244\" y1=\"98.7\" x2=\"135\" y2=\"161.6\"/><line class=\"fl fd\" x1=\"98.7\" y1=\"98.7\" x2=\"244\" y2=\"98.7\"/><line class=\"fl fd\" x1=\"98.7\" y1=\"98.7\" x2=\"135\" y2=\"35.7\"/><path class=\"fa\" d=\"M233.6 92.7 A12 12 0 0 0 233.6 104.7\"/><text class=\"ft fn\" x=\"220\" y=\"98.7\" text-anchor=\"middle\" dominant-baseline=\"central\">60°</text><text class=\"ft fn\" x=\"127.2\" y=\"73.2\" text-anchor=\"middle\" dominant-baseline=\"central\">5</text><circle class=\"fp\" cx=\"98.7\" cy=\"98.7\" r=\"2.6\"/><text class=\"ft\" x=\"86.7\" y=\"98.7\" text-anchor=\"middle\" dominant-baseline=\"central\">O</text><circle class=\"fp\" cx=\"244\" cy=\"98.7\" r=\"2.6\"/><text class=\"ft\" x=\"257\" y=\"98.7\" text-anchor=\"middle\" dominant-baseline=\"central\">A</text><circle class=\"fp\" cx=\"135\" cy=\"35.7\" r=\"2.6\"/><text class=\"ft\" x=\"131.4\" y=\"23.2\" text-anchor=\"middle\" dominant-baseline=\"central\">B</text><circle class=\"fp\" cx=\"135\" cy=\"161.6\" r=\"2.6\"/><text class=\"ft\" x=\"131.4\" y=\"174.1\" text-anchor=\"middle\" dominant-baseline=\"central\">C</text></svg></figure>"
  },
  {
   "id": "b05-l4-h3",
   "q": "Из точки $A$ проведены касательная $AT=6$ и секущая, пересекающая окружность в точках $B$ и $C$ ($B$ между $A$ и $C$), $AB=3$. Найдите $AC$.",
   "a": 12,
   "hint": "Квадрат касательной равен произведению секущей на её внешнюю часть: $AT^2=AB\\cdot AC$.",
   "sol": [
