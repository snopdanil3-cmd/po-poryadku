 "hard": [
  {
   "id": "b05-l5-h1",
   "q": "Стороны треугольника равны $10$, $10$ и $12$. Найдите радиус вписанной окружности.",
   "a": 3,
   "hint": "Высота к основанию равнобедренного треугольника находится по теореме Пифагора. Затем $r=\\dfrac Sp$.",
   "sol": [
    "Высота к основанию $\\sqrt{10^2-6^2}=8$, $S=\\dfrac12\\cdot12\\cdot8=48$.",
    "$p=\\dfrac{10+10+12}2=16$.",
    "$r=\\dfrac{48}{16}=3$."
   ],
