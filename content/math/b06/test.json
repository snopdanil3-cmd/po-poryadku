   "hint": "",
   "sol": [
    "$\\vec a+\\vec b=(9-6;\\,-4+8)=(3;4)$.",
    "$|\\vec a+\\vec b|=\\sqrt{9+16}=5$."
   ],
   "lesson": "l01"
  },
