  {
   "id": "b06-test-4",
   "q": "Вершины треугольника $A(1;2)$, $B(7;-1)$, $C(4;8)$. Найдите сумму координат точки пересечения медиан.",
   "a": 7,
   "hint": "",
   "sol": [
    "$x=\\dfrac{1+7+4}3=4$, $y=\\dfrac{2-1+8}3=3$.",
    "Сумма координат $4+3=7$."
   ],
   "lesson": "l01"
  },
  {
   "id": "b06-test-5",
   "q": "Векторы $\\vec a(6;k)$ и $\\vec b(-9;12)$ коллинеарны. Найдите $k$.",
   "a": -8,
   "hint": "",
   "sol": [
    "Координаты пропорциональны: $\\dfrac{6}{-9}=\\dfrac{k}{12}$.",
    "$k=12\\cdot\\dfrac{6}{-9}=-8$."
   ],
   "lesson": "l01"
  },
  {
   "id": "b06-test-6",
   "q": "Стороны прямоугольника $ABCD$ равны $AB=5$ и $AD=12$. Найдите скалярное произведение $\\overrightarrow{AC}\\cdot\\overrightarrow{BD}$.",
   "a": 119,
   "hint": "",
   "sol": [
    "$A(0;0)$, $B(5;0)$, $C(5;12)$, $D(0;12)$.",
    "$\\overrightarrow{AC}=(5;12)$, $\\overrightarrow{BD}=(-5;12)$.",
    "$\\overrightarrow{AC}\\cdot\\overrightarrow{BD}=-25+144=119$."
   ],
   "lesson": "l02",
   "fig": "<figure class=\"fig\"><svg viewBox=\"0 0 270 235\" width=\"270\" height=\"235\" role=\"img\" aria-label=\"Прямоугольник ABCD со сторонами 5 и 12 и диагоналями AC и BD\"><line class=\"fl\" x1=\"96.9\" y1=\"209\" x2=\"173.1\" y2=\"209\"/><line class=\"fl\" x1=\"173.1\" y1=\"209\" x2=\"173.1\" y2=\"26\"/><line class=\"fl\" x1=\"173.1\" y1=\"26\" x2=\"96.9\" y2=\"26\"/><line class=\"fl\" x1=\"96.9\" y1=\"26\" x2=\"96.9\" y2=\"209\"/><line class=\"fl fd\" x1=\"96.9\" y1=\"209\" x2=\"173.1\" y2=\"26\"/><line class=\"fl fd\" x1=\"173.1\" y1=\"209\" x2=\"96.9\" y2=\"26\"/><text class=\"ft fn\" x=\"135\" y=\"221\" text-anchor=\"middle\" dominant-baseline=\"central\">5</text><text class=\"ft fn\" x=\"84.9\" y=\"117.5\" text-anchor=\"middle\" dominant-baseline=\"central\">12</text><circle class=\"fp\" cx=\"96.9\" cy=\"209\" r=\"2.6\"/><text class=\"ft\" x=\"91.9\" y=\"221\" text-anchor=\"middle\" dominant-baseline=\"central\">A</text><circle class=\"fp\" cx=\"173.1\" cy=\"209\" r=\"2.6\"/><text class=\"ft\" x=\"178.1\" y=\"221\" text-anchor=\"middle\" dominant-baseline=\"central\">B</text><circle class=\"fp\" cx=\"173.1\" cy=\"26\" r=\"2.6\"/><text class=\"ft\" x=\"178.1\" y=\"14\" text-anchor=\"middle\" dominant-baseline=\"central\">C</text><circle class=\"fp\" cx=\"96.9\" cy=\"26\" r=\"2.6\"/><text class=\"ft\" x=\"91.9\" y=\"14\" text-anchor=\"middle\" dominant-baseline=\"central\">D</text></svg></figure>"
