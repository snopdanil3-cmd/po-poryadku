 "hard": [
  {
   "id": "b06-l2-h1",
   "q": "Длины векторов $|\\vec a|=3$ и $|\\vec b|=4$, угол между ними равен $60^\\circ$. Найдите $\\vec a\\cdot\\vec b$.",
   "a": 6,
   "hint": "Используйте определение $\\vec a\\cdot\\vec b=|\\vec a|\\,|\\vec b|\\cos\\varphi$.",
   "sol": [
    "$\\cos60^\\circ=\\dfrac12$.",
    "$\\vec a\\cdot\\vec b=3\\cdot4\\cdot\\dfrac12=6$."
   ]
  },
  {
   "id": "b06-l2-h2",
   "q": "Длины векторов $|\\vec a|=2$ и $|\\vec b|=3$, угол между ними равен $120^\\circ$. Найдите $|\\vec a+\\vec b|^2$.",
   "a": 7,
   "hint": "$|\\vec a+\\vec b|^2=|\\vec a|^2+2\\,\\vec a\\cdot\\vec b+|\\vec b|^2$.",
   "sol": [
    "$\\vec a\\cdot\\vec b=2\\cdot3\\cdot\\cos120^\\circ=-3$.",
    "$|\\vec a+\\vec b|^2=4+2\\cdot(-3)+9=7$."
   ]
  },
  {
   "id": "b06-l2-h3",
   "q": "Даны векторы $\\vec a(1;2)$ и $\\vec b(4;-3)$. При каком $k$ вектор $\\vec a+k\\vec b$ перпендикулярен вектору $\\vec b$?",
   "a": 0.08,
   "hint": "Составьте уравнение $(\\vec a+k\\vec b)\\cdot\\vec b=0$ и раскройте скобки.",
   "sol": [
    "$\\vec a\\cdot\\vec b=4-6=-2$, $\\vec b\\cdot\\vec b=16+9=25$.",
    "$(\\vec a+k\\vec b)\\cdot\\vec b=-2+25k=0$.",
    "$k=\\dfrac2{25}=0{,}08$."
   ]
  },
  {
   "id": "b06-l2-h4",
