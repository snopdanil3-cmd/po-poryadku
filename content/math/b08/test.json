{
 "id": "test",
 "title": "Контрольная блока 8",
 "minutes": 30,
 "passPct": 80,
 "intro": "Восемь задач, около 30 минут. Порог 80%: нужно решить не меньше 7 из 8. Подсказок и решений до конца нет.",
 "tasks": [
  {
   "id": "b08-test-1",
   "q": "Прямая $y=kx+b$ проходит через точки $(-2;-5)$ и $(1;4)$. Найдите значение $y$ при $x=3$.",
   "a": 10,
   "hint": "",
   "sol": [
    "$k=\\dfrac{4-(-5)}{1-(-2)}=3$.",
    "$4=3\\cdot1+b$, $b=1$.",
    "$y(3)=10$."
   ],
   "lesson": "l01"
  },
  {
