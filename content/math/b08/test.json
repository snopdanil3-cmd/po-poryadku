   "id": "b08-test-3",
   "q": "При каком значении $a$ график $y=(3a-1)x+2$ параллелен графику $y=5x-7$?",
   "a": 2,
   "hint": "",
   "sol": [
    "$3a-1=5$.",
    "$3a=6$, $a=2$."
   ],
   "lesson": "l01"
  },
  {
   "id": "b08-test-4",
   "q": "Найдите наименьшее значение функции $y=x^2+6x+4$.",
   "a": -5,
   "hint": "",
   "sol": [
    "Ветви вверх, минимум в вершине: $x_0=-\\dfrac62=-3$.",
    "$y(-3)=9-18+4=-5$."
   ],
   "lesson": "l02"
  },
  {
   "id": "b08-test-5",
