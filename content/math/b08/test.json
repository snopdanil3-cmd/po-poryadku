  {
   "id": "b08-test-6",
   "q": "Найдите наибольшее значение функции $y=-x^2+6x-1$ на отрезке $[4;6]$.",
   "a": 7,
   "hint": "",
   "sol": [
    "Вершина $x_0=3$ левее отрезка, правее вершины функция убывает.",
    "Наибольшее значение в левом конце: $y(4)=-16+24-1=7$."
   ],
   "lesson": "l02"
  },
  {
   "id": "b08-test-7",
   "q": "График функции $y=a\\sqrt x$ проходит через точку $(16;12)$. Найдите $y(49)$.",
   "a": 21,
   "hint": "",
   "sol": [
    "$12=a\\sqrt{16}=4a$, $a=3$.",
    "$y(49)=3\\cdot7=21$."
   ],
   "lesson": "l03"
  },
  {
   "id": "b08-test-8",
   "q": "График функции $y=\\dfrac1x$ сдвинули на $1$ влево и на $2$ вниз. Найдите значение полученной функции при $x=3$.",
   "a": -1.75,
   "hint": "",
   "sol": [
    "Сдвиг влево на $1$: $x\\to x+1$. Сдвиг вниз на $2$: вычитаем $2$.",
    "$y=\\dfrac1{x+1}-2$, $y(3)=\\dfrac14-2=-1{,}75$."
   ],
   "lesson": "l03"
  }
 ]
