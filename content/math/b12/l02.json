  {
   "id": "b12-l2-h5",
   "q": "Найдите положительную абсциссу точки, в которой касательная к графику функции $f(x)=x^3-3x$ параллельна оси абсцисс.",
   "a": 1,
   "hint": "Решите $f'(x)=0$.",
   "sol": [
    "$3x^2-3=0$, $x=\\pm1$.",
    "Положительная абсцисса $1$."
   ]
  },
  {
   "id": "b12-l2-h6",
   "q": "Точка движется по закону $s(t)=t^3-6t^2+9t$. В какой наибольший момент времени $t$ скорость точки равна нулю?",
   "a": 3,
   "hint": "Решите $s'(t)=0$.",
   "sol": [
    "$v(t)=3t^2-12t+9=3(t-1)(t-3)$.",
    "Скорость равна нулю при $t=1$ и $t=3$, наибольший момент $3$."
   ]
  },
  {
   "id": "b12-l2-h7",
   "q": "Точка движется по закону $s(t)=t^4-2t^3$. Найдите её ускорение в момент $t=2$ (ускорение равно второй производной пути).",
   "a": 24,
   "hint": "$a(t)=v'(t)=s''(t)$.",
   "sol": [
    "$v(t)=4t^3-6t^2$, $a(t)=12t^2-12t$.",
    "$a(2)=48-24=24$."
   ]
  },
  {
   "id": "b12-l2-h8",
   "q": "Найдите значение в точке $x=0$ касательной к графику функции $f(x)=\\dfrac1x$, проведённой в точке с абсциссой $x_0=2$.",
   "a": 1,
   "hint": "$f'(x)=-\\dfrac1{x^2}$.",
   "sol": [
    "$f(2)=\\dfrac12$, $f'(2)=-\\dfrac14$.",
    "$y=\\dfrac12-\\dfrac14(x-2)$, $y(0)=\\dfrac12+\\dfrac12=1$."
   ]
  },
  {
   "id": "b12-l2-h9",
   "q": "Касательная к графику функции $f(x)=\\dfrac{x^2}4$ в точке $x_0$ образует с осью абсцисс угол $45^\\circ$. Найдите $x_0$.",
   "a": 2,
   "hint": "$f'(x_0)=\\mathrm{tg}\\,45^\\circ=1$.",
   "sol": [
    "$f'(x)=\\dfrac x2=1$.",
    "$x_0=2$."
   ]
  },
  {
   "id": "b12-l2-h10",
   "q": "Найдите значение в точке $x=1$ касательной к графику функции $f(x)=e^{2x}$, проведённой в точке с абсциссой $x_0=0$.",
   "a": 3,
   "hint": "$f(0)=1$, $f'(x)=2e^{2x}$.",
   "sol": [
    "$f'(0)=2$, $y=1+2x$.",
    "$y(1)=3$."
   ]
  }
 ]
