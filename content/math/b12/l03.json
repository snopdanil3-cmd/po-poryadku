   "id": "b12-l3-4",
   "q": "Найдите точку максимума функции $f(x)=x^3-12x$.",
   "a": -2,
   "hint": "Решите $f'(x)=0$ и определите смену знака.",
   "sol": [
    "$f'(x)=3x^2-12=3(x-2)(x+2)$.",
    "Знаки: $+$ при $x<-2$, $-$ на $(-2;2)$, $+$ при $x>2$. Максимум в точке $x=-2$."
   ]
  },
  {
   "id": "b12-l3-5",
   "q": "Найдите точку минимума функции $f(x)=x\\sqrt x-3x$.",
   "a": 4,
   "hint": "Область определения $x\\ge0$. $f(x)=x^{3/2}-3x$.",
   "sol": [
    "$f'(x)=\\dfrac32\\sqrt x-3=0$, $\\sqrt x=2$, $x=4$.",
    "Слева от $4$ производная отрицательна, справа положительна: минимум."
   ]
  },
  {
   "id": "b12-l3-6",
   "q": "Найдите точку максимума функции $f(x)=x^2e^{-x}$.",
   "a": 2,
   "hint": "$f'(x)=2xe^{-x}-x^2e^{-x}=xe^{-x}(2-x)$.",
   "sol": [
    "Нули производной $x=0$ и $x=2$; $e^{-x}>0$.",
    "Знаки: $-$ при $x<0$, $+$ на $(0;2)$, $-$ при $x>2$. Максимум в точке $x=2$."
   ]
  }
