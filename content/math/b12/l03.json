  {
   "id": "b12-l3-h3",
   "q": "Найдите количество целых точек, в которых функция $f(x)=-x^3+3x$ возрастает.",
   "a": 1,
   "hint": "Решите неравенство $f'(x)>0$.",
   "sol": [
    "$f'(x)=3-3x^2>0$ при $-1<x<1$.",
    "Целая точка в этом интервале одна: $0$."
   ]
  },
  {
   "id": "b12-l3-h4",
   "q": "Найдите длину промежутка убывания функции $f(x)=x^3-6x^2$.",
   "a": 4,
   "hint": "$f'(x)<0$.",
   "sol": [
    "$f'(x)=3x^2-12x=3x(x-4)<0$ при $0<x<4$.",
    "Длина промежутка $4$."
   ]
  },
  {
   "id": "b12-l3-h5",
   "q": "Найдите точку минимума функции $f(x)=x+\\dfrac4x$ на промежутке $x>0$.",
   "a": 2,
   "hint": "$f'(x)=1-\\dfrac4{x^2}$.",
   "sol": [
    "$1-\\dfrac4{x^2}=0$, $x^2=4$, $x=2$ (берём $x>0$).",
    "Слева от $2$ производная отрицательна, справа положительна: минимум."
   ]
  },
  {
   "id": "b12-l3-h6",
   "q": "Найдите количество точек экстремума функции $f(x)=x^4-8x^2$.",
   "a": 3,
   "hint": "$f'(x)=4x^3-16x=4x(x-2)(x+2)$.",
   "sol": [
    "Три нуля производной: $-2$, $0$, $2$. В каждом знак меняется (корни простые).",
    "Точек экстремума $3$."
   ]
  },
  {
   "id": "b12-l3-h7",
   "q": "Найдите точку минимума функции $f(x)=xe^x$.",
   "a": -1,
   "hint": "$f'(x)=e^x(1+x)$.",
   "sol": [
