 "hard": [
  {
   "id": "b12-l5-h1",
   "q": "Найдите $\\displaystyle\\int_1^4\\dfrac{dx}{\\sqrt x}$.",
   "a": 2,
   "hint": "$\\dfrac1{\\sqrt x}=x^{-1/2}$, первообразная $2\\sqrt x$.",
   "sol": [
    "$F(x)=2\\sqrt x$.",
    "$F(4)-F(1)=4-2=2$."
   ]
  },
  {
   "id": "b12-l5-h2",
   "q": "Найдите $\\displaystyle\\int_0^{\\ln3}e^x\\,dx$.",
   "a": 2,
   "hint": "Первообразная $e^x$.",
   "sol": [
    "$e^{\\ln3}-e^0=3-1=2$."
   ]
  },
  {
   "id": "b12-l5-h3",
   "q": "Найдите $\\displaystyle\\int_1^e\\dfrac{dx}x$.",
   "a": 1,
   "hint": "Первообразная $\\ln x$.",
   "sol": [
    "$\\ln e-\\ln1=1$."
   ]
  },
  {
   "id": "b12-l5-h4",
   "q": "Для $f(x)=4x-1$ найдите первообразную $F$, для которой $F(0)=3$. В ответе укажите $F(2)$.",
   "a": 9,
   "hint": "$F(x)=2x^2-x+C$.",
   "sol": [
    "$C=F(0)=3$.",
    "$F(2)=8-2+3=9$."
   ]
  },
  {
   "id": "b12-l5-h5",
   "q": "Найдите $\\displaystyle\\int_{-1}^2|x|\\,dx$.",
   "a": 2.5,
   "hint": "Разбейте интеграл в нуле: $|x|=-x$ при $x<0$.",
   "sol": [
    "$\\displaystyle\\int_{-1}^0(-x)dx=\\dfrac12$, $\\displaystyle\\int_0^2x\\,dx=2$.",
    "Сумма $2{,}5$."
   ]
  },
  {
   "id": "b12-l5-h6",
   "q": "Найдите $\\displaystyle\\int_0^{\\pi/2}(\\sin x+\\cos x)\\,dx$.",
   "a": 2,
   "hint": "Первообразная $-\\cos x+\\sin x$.",
   "sol": [
    "$(-\\cos x+\\sin x)\\Big|_0^{\\pi/2}=(0+1)-(-1+0)=2$."
   ]
  },
  {
   "id": "b12-l5-h7",
   "q": "Найдите площадь фигуры, ограниченной графиком $y=3\\sqrt x$, осью абсцисс и прямой $x=4$.",
   "a": 16,
   "hint": "Первообразная $3\\cdot\\dfrac23x^{3/2}=2x\\sqrt x$.",
   "sol": [
    "$S=2x\\sqrt x\\Big|_0^4=2\\cdot4\\cdot2=16$."
   ]
  },
  {
   "id": "b12-l5-h8",
   "q": "Найдите площадь фигуры, ограниченной графиками $y=x$ и $y=x^3$ на отрезке $[0;\\,1]$.",
   "a": 0.25,
   "hint": "На $[0;1]$ график $y=x$ лежит выше $y=x^3$.",
   "sol": [
    "$S=\\displaystyle\\int_0^1(x-x^3)dx=\\dfrac12-\\dfrac14=0{,}25$."
   ]
  },
  {
   "id": "b12-l5-h9",
   "q": "Найдите положительное число $a$, для которого $\\displaystyle\\int_0^a3x^2\\,dx=27$.",
   "a": 3,
   "hint": "Вычислите интеграл через $a$.",
   "sol": [
    "$a^3-0=27$.",
    "$a=3$."
   ]
  },
  {
   "id": "b12-l5-h10",
   "q": "Найдите $\\displaystyle\\int_1^2\\left(2x-\\dfrac1{x^2}\\right)dx$.",
   "a": 2.5,
   "hint": "Первообразная $x^2+\\dfrac1x$.",
   "sol": [
    "$F(2)-F(1)=\\left(4+\\dfrac12\\right)-(1+1)=2{,}5$."
   ]
  }
 ]
