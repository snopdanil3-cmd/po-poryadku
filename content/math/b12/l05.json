 "tasks": [
  {
   "id": "b12-l5-1",
   "q": "Найдите $\\displaystyle\\int_1^3 2x\\,dx$.",
   "a": 8,
   "hint": "Первообразная $x^2$.",
   "sol": [
    "$F(x)=x^2$.",
    "$F(3)-F(1)=9-1=8$."
   ]
  },
  {
   "id": "b12-l5-2",
   "q": "Найдите $\\displaystyle\\int_0^1(6x^2-2x)\\,dx$.",
   "a": 1,
   "hint": "Каждое слагаемое интегрируйте отдельно.",
   "sol": [
    "$F(x)=2x^3-x^2$.",
    "$F(1)-F(0)=1$."
   ]
  },
  {
   "id": "b12-l5-3",
   "q": "Найдите $\\displaystyle\\int_0^{\\pi}3\\sin x\\,dx$.",
   "a": 6,
   "hint": "Первообразная для $\\sin x$ равна $-\\cos x$.",
   "sol": [
    "$F(x)=-3\\cos x$.",
    "$F(\\pi)-F(0)=3+3=6$."
   ]
  },
  {
   "id": "b12-l5-4",
   "q": "Для функции $f(x)=3x^2-2$ найдите первообразную, график которой проходит через точку $(1;\\,4)$. В ответе укажите $F(2)$.",
   "a": 9,
   "hint": "$F(x)=x^3-2x+C$, найдите $C$ из условия.",
   "sol": [
    "$1-2+C=4$, $C=5$.",
    "$F(2)=8-4+5=9$."
   ]
  },
  {
   "id": "b12-l5-5",
   "q": "Найдите площадь фигуры, ограниченной графиком $y=x^3$, осью абсцисс и прямой $x=2$.",
   "a": 4,
   "hint": "Интеграл от $0$ до $2$.",
   "sol": [
    "$S=\\displaystyle\\int_0^2x^3dx=\\dfrac{x^4}4\\Big|_0^2=4$."
   ]
  },
  {
   "id": "b12-l5-6",
   "q": "Найдите площадь фигуры, ограниченной графиками $y=x^2$ и $y=x+2$.",
   "a": 4.5,
   "hint": "Найдите абсциссы точек пересечения и проинтегрируйте разность «верхняя минус нижняя».",
   "sol": [
    "$x^2=x+2$, $x=-1$ и $x=2$.",
    "$S=\\displaystyle\\int_{-1}^2(x+2-x^2)dx=\\left(\\dfrac{x^2}2+2x-\\dfrac{x^3}3\\right)\\Big|_{-1}^2=\\dfrac{10}3+\\dfrac76=4{,}5$."
   ],
